      "schemaOwner": "dbo",
      "createOrAlterSql": "CREATE OR ALTER VIEW dbo.View_TchpQcOrderAvailableSize AS SELECT CAST(o.QcOrderId AS BIGINT) * 1000000000 + CAST(srs.SizeRunSizeId AS BIGINT) AS QcOrderAvailableSizeId, o.QcOrderId, o.StyleSpecId, srs.SizeRunId, srs.SizeRunSizeId, srs.SizeLabel, srs.SizeOrder, srs.IsActive FROM dbo.TchpQcOrder AS o INNER JOIN dbo.TchpStyleSpec AS ss ON ss.StyleSpecId = o.StyleSpecId INNER JOIN dbo.TchpSizeRunSize AS srs ON srs.SizeRunId = ss.SizeRunId WHERE ISNULL(srs.IsActive, 1) = 1"
